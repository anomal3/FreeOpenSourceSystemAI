	key <AB08> { type[Group1]= "TWO_LEVEL", type[Group2]= "ALPHABETIC", symbols[Group1]= [ comma, less ], symbols[Group2]= [ Cyrillic_be, Cyrillic_BE ] };
	key <AB09> { type[Group1]= "TWO_LEVEL", type[Group2]= "ALPHABETIC", symbols[Group1]= [ period, greater ], symbols[Group2]= [ Cyrillic_yu, Cyrillic_YU ] };
