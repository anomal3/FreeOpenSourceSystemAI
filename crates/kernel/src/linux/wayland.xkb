	key <AD12> { type[Group1]= "TWO_LEVEL", type[Group2]= "ALPHABETIC", symbols[Group1]= [ bracketright, braceright ], symbols[Group2]= [ Cyrillic_hardsign, Cyrillic_HARDSIGN ] };
