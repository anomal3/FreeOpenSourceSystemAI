xkb_types "fossai" {
	virtual_modifiers NumLock;
	type "ONE_LEVEL" {
		modifiers= none;
		level_name[Level1]= "Any";
	};
	type "TWO_LEVEL" {
		modifiers= Shift;
		map[Shift]= Level2;
		level_name[Level1]= "Base";
		level_name[Level2]= "Shift";
	};
	type "ALPHABETIC" {
		modifiers= Shift+Lock;
		map[Shift]= Level2;
		map[Lock]= Level2;
		level_name[Level1]= "Base";
		level_name[Level2]= "Caps";
	};
	type "KEYPAD" {
		modifiers= Shift+NumLock;
		map[None]= Level1;
		map[Shift]= Level2;
		map[NumLock]= Level2;
		map[Shift+NumLock]= Level1;
		level_name[Level1]= "Base";
		level_name[Level2]= "Number";
	};
};
xkb_compatibility "fossai" {
	virtual_modifiers NumLock;
	interpret.useModMapMods= AnyLevel;
	interpret.repeat= False;
	interpret Shift_L+AnyOfOrNone(all) { action= SetMods(modifiers=Shift,clearLocks); };
	interpret Shift_R+AnyOfOrNone(all) { action= SetMods(modifiers=Shift,clearLocks); };
	interpret Caps_Lock+AnyOfOrNone(all) { action= LockMods(modifiers=Lock); };
	interpret Control_L+AnyOfOrNone(all) { action= SetMods(modifiers=Control,clearLocks); };
	interpret Control_R+AnyOfOrNone(all) { action= SetMods(modifiers=Control,clearLocks); };
	interpret Alt_L+AnyOfOrNone(all) { action= SetMods(modifiers=Mod1,clearLocks); };
	interpret Alt_R+AnyOfOrNone(all) { action= SetMods(modifiers=Mod1,clearLocks); };
	interpret Super_L+AnyOfOrNone(all) { action= SetMods(modifiers=Mod4,clearLocks); };
	interpret Super_R+AnyOfOrNone(all) { action= SetMods(modifiers=Mod4,clearLocks); };
	interpret Num_Lock+AnyOfOrNone(all) { virtualModifier= NumLock; action= LockMods(modifiers=NumLock); };
};
xkb_symbols "fossai" {
	name[Group1]= "English (US)";
	name[Group2]= "Russian";
	virtual_modifiers NumLock;
	key <ESC> { [ Escape ] };
	key <AE01> { type[Group1]= "TWO_LEVEL", type[Group2]= "TWO_LEVEL", symbols[Group1]= [ 1, exclam ], symbols[Group2]= [ 1, exclam ] };
	key <AE02> { type[Group1]= "TWO_LEVEL", type[Group2]= "TWO_LEVEL", symbols[Group1]= [ 2, at ], symbols[Group2]= [ 2, quotedbl ] };
	key <AE03> { type[Group1]= "TWO_LEVEL", type[Group2]= "TWO_LEVEL", symbols[Group1]= [ 3, numbersign ], symbols[Group2]= [ 3, numerosign ] };
	key <AE04> { type[Group1]= "TWO_LEVEL", type[Group2]= "TWO_LEVEL", symbols[Group1]= [ 4, dollar ], symbols[Group2]= [ 4, semicolon ] };
	key <AE05> { type[Group1]= "TWO_LEVEL", type[Group2]= "TWO_LEVEL", symbols[Group1]= [ 5, percent ], symbols[Group2]= [ 5, percent ] };
	key <AE06> { type[Group1]= "TWO_LEVEL", type[Group2]= "TWO_LEVEL", symbols[Group1]= [ 6, asciicircum ], symbols[Group2]= [ 6, colon ] };
	key <AE07> { type[Group1]= "TWO_LEVEL", type[Group2]= "TWO_LEVEL", symbols[Group1]= [ 7, ampersand ], symbols[Group2]= [ 7, question ] };
	key <AE08> { type[Group1]= "TWO_LEVEL", type[Group2]= "TWO_LEVEL", symbols[Group1]= [ 8, asterisk ], symbols[Group2]= [ 8, asterisk ] };
	key <AE09> { type[Group1]= "TWO_LEVEL", type[Group2]= "TWO_LEVEL", symbols[Group1]= [ 9, parenleft ], symbols[Group2]= [ 9, parenleft ] };
	key <AE10> { type[Group1]= "TWO_LEVEL", type[Group2]= "TWO_LEVEL", symbols[Group1]= [ 0, parenright ], symbols[Group2]= [ 0, parenright ] };
	key <AE11> { type[Group1]= "TWO_LEVEL", type[Group2]= "TWO_LEVEL", symbols[Group1]= [ minus, underscore ], symbols[Group2]= [ minus, underscore ] };
	key <AE12> { type[Group1]= "TWO_LEVEL", type[Group2]= "TWO_LEVEL", symbols[Group1]= [ equal, plus ], symbols[Group2]= [ equal, plus ] };
	key <BKSP> { [ BackSpace ] };
	key <TAB> { type= "TWO_LEVEL", [ Tab, ISO_Left_Tab ] };
	key <AD01> { type[Group1]= "ALPHABETIC", type[Group2]= "ALPHABETIC", symbols[Group1]= [ q, Q ], symbols[Group2]= [ Cyrillic_shorti, Cyrillic_SHORTI ] };
	key <AD02> { type[Group1]= "ALPHABETIC", type[Group2]= "ALPHABETIC", symbols[Group1]= [ w, W ], symbols[Group2]= [ Cyrillic_tse, Cyrillic_TSE ] };
