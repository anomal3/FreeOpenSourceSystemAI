/* Раскладка пользовательской программы.
 *
 * Адрес загрузки фиксирован и одинаков на обеих архитектурах — 512 ГиБ. Это не
 * произвольное число: и на x86-64, и на AArch64 младшая половина адресного
 * пространства уже занята ядром (образ ядра исполняется identity-отображённым,
 * рядом лежит отображение всей физической памяти), и всё это помещается в
 * первую запись корневой таблицы, покрывающую первые 512 ГиБ. Вторая запись
 * свободна — программа живёт в ней.
 *
 * Секции разведены по страницам намеренно. Ядро отображает каждую страницу с
 * правами того сегмента, которому она принадлежит, и отказывается отображать
 * страницу одновременно записываемой и исполняемой. Код и данные, попавшие в
 * одну страницу, сделали бы такую страницу неизбежной.
 *
 * Имена секций перечислены дважды, с приставкой `l` и без неё, и это не
 * избыточность. На x86-64 программа собирается с большой моделью кода, а в ней
 * компилятор кладёт всё в `.ltext`, `.lrodata`, `.lbss` — шаблон `.text*`
 * такую секцию не ловит. Не пойманная сценарием секция становится «сиротой», и
 * раскладывает её компоновщик по своим правилам: в оптимизированной сборке
 * `.lrodata` и `.lbss` оказывались на одной странице с кодом, то есть страница
 * выходила записываемой и исполняемой сразу, и ядро отказывалось загружать
 * такую программу. Оно было право — виноват был сценарий.
 *
 * Выравнивание задаётся **атрибутом секции** (`.rodata ALIGN(0x1000) :`), а не
 * только присваиванием `. = ALIGN(0x1000)` перед ней. Разница не косметическая:
 * присваивание двигает счётчик адресов, но компоновщик вправе положить секцию
 * по её собственному выравниванию, и в оптимизированной сборке он так и делал —
 * сегменты выходили с адресами вроде 0x175bb, деля страницу с соседями. Ядро
 * отказывалось загружать такую программу словами «страница была бы записываемой
 * и исполняемой одновременно», и было право.
 */

ENTRY(_start)

SECTIONS
{
    . = 0x0000008000000000;

    .text : ALIGN(0x1000) {
        *(.text._start)
        *(.ltext._start)
        *(.text .text.*)
        *(.ltext .ltext.*)
    }

    . = ALIGN(0x1000);
    .rodata ALIGN(0x1000) : {
        *(.rodata .rodata.*)
        *(.lrodata .lrodata.*)
    }

    . = ALIGN(0x1000);
    .data ALIGN(0x1000) : {
        *(.data .data.*)
        *(.ldata .ldata.*)
        *(.got .got.plt)
    }

    /* `.bss` живёт в том же сегменте, что и `.data`: оба доступны на запись, и
     * разводить их по страницам незачем — разделять надо права, а не имена. */
    .bss ALIGN(0x10) : {
        *(.bss .bss.*)
        *(.lbss .lbss.*)
        *(COMMON)
    }

    /* Всё, что не нужно на исполнении: отладочная информация, таблицы
     * раскрутки стека, комментарии компилятора. Оставленные в образе, они
     * попали бы в сегменты и потребовали бы страниц. */
    /DISCARD/ : {
        *(.eh_frame)
        *(.eh_frame_hdr)
        *(.comment)
        *(.note .note.*)
    }
}
