/target
/build
*.img
*.fd
*.log
**/*.rs.bk
.DS_Store

# Прошивка тачскрина телефона: чужая, несвободная и не наша, чтобы её
# раздавать. Кладётся сюда `cargo xtask phone-firmware`; см. firmware/README.md.
/firmware/novatek/*.bin
# Прошивки блока связи телефона (Wi-Fi/BT, MT6765 CONNSYS) — так же чужие.
/firmware/connsys/
# Разделы модема, снятые с eMMC телефона (`oem emmc part`): чужая прошивка
# и NVRAM этого аппарата с IMEI и калибровкой радио — никуда не выкладывать.
/firmware/modem/
# Копии заводских разделов телефона (boot, dtbo, vbmeta) — для возврата.
/firmware/stock/
