# FreeOS services, read by /bin/init at boot.
# One service per line: <name> <path> [uid] [gid]
# A service that keeps failing is stopped, and the log says so.
#
# This is the reference copy: it arrives with the system image and is replaced
# with it. Edits belong in /etc/services, which is read first and which an
# update never touches -- and which therefore freezes this list on the version
# where the edit was made. Deleting /etc/services goes back to this file.
#
# There is exactly one copy of it in the repository, this one. It reaches a
# live system inside the initrd, an installed system through the installer
# (FREEOS/SERVICES on the medium), and an updated system inside the container.
logger /bin/svclog 0 0
# Клиент DHCP работает от root: адрес интерфейса — решение о машине целиком, и
# ядро принимает его только от нулевого uid. На машине без сетевой карты служба
# говорит об этом и завершается с нулём — супервизор не считает это падением.
dhcp /bin/dhcp 0 0
# Сервер SSH. Тоже от root: он читает ключ хоста (0600) и слушает порт 22,
# а порты ниже 1024 в чужих системах принадлежат суперпользователю.
sshd /bin/sshd 0 0
