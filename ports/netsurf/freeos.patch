+/* FreeOS: toolbar icons follow a tall toolbar (the phone asks for 56 px).
+ * Bitmaps are stretched to the button height but keep their own width, so
+ * on a tall toolbar they became thin slivers; here each one is enlarged by
+ * a whole factor (nearest pixel) once, before the toolbar is laid out. */
+static void freeos_scale_bitmap(struct fbtk_bitmap *image, int k)
+{
+	uint32_t *src = (uint32_t *)image->pixdata;
+	uint32_t *dst;
+	int x, y;
+
+	dst = malloc((size_t)image->width * k * image->height * k * 4);
+	if (dst == NULL)
+		return;
+	for (y = 0; y < image->height * k; y++)
+		for (x = 0; x < image->width * k; x++)
+			dst[y * image->width * k + x] =
+				src[(y / k) * image->width + x / k];
+	image->pixdata = (uint8_t *)dst;
+	image->width *= k;
+	image->height *= k;
+}
+
+static void freeos_scale_toolbar(int room)
+{
+	static bool done = false;
+	struct fbtk_bitmap *images[] = {
+		&left_arrow, &right_arrow, &reload, &stop_image,
+		&history_image, &left_arrow_g, &right_arrow_g, &reload_g,
+		&stop_image_g, &history_image_g, &throbber0, &throbber1,
+		&throbber2, &throbber3, &throbber4, &throbber5, &throbber6,
+		&throbber7, &throbber8,
+	};
+	size_t i;
+	int k;
+
+	if (done)
+		return;
+	done = true;
+	k = room / left_arrow.height;
+	if (k > 3)
+		k = 3;
+	if (k < 2)
+		return;
+	NSLOG(netsurf, INFO, "toolbar icons scaled %dx", k);
+	for (i = 0; i < sizeof(images) / sizeof(images[0]); i++)
+		freeos_scale_bitmap(images[i], k);
+}
