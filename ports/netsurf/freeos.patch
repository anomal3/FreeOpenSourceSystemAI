diff -ru a/Makefile b/Makefile
--- a/Makefile	2026-11-03 19:19:36.825251713 +0000
+++ b/Makefile	2026-11-03 19:19:37.173262727 +0000
@@ -331,7 +331,8 @@
 $(EXETARGET): $(OBJECTS) $(RESOURCES) $(MESSAGES) tools/linktrace-to-depfile.pl
 	$(VQ)echo "    LINK: $(EXETARGET)"
 ifneq ($(TARGET),riscos)
-	$(Q)$(CC) -o $(EXETARGET) $(OBJECTS) $(LDFLAGS) > $(DEPROOT)/link-raw.d
+	$(file >$(OBJROOT)/objects.rsp,$(OBJECTS))
+	$(Q)$(CC) -o $(EXETARGET) @$(OBJROOT)/objects.rsp $(LDFLAGS) > $(DEPROOT)/link-raw.d
 else
 	@# RISC OS targets are a bit special: we need to convert ELF -> AIF
   ifeq ($(SUBTARGET),-aof)
