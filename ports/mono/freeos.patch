--- /dev/null
+++ b/mono/utils/mono-threads-freeos.c
@@ -0,0 +1,49 @@
+/**
+ * \file
+ * FreeOS: stack bounds and the OS thread id.
+ *
+ * The kernel allocates every thread stack itself (with a guard page below it),
+ * so the libc learns the bounds from the kernel and hands them out through the
+ * same pthread_getattr_np/pthread_attr_getstack pair Linux uses.
+ */
+
+#include <config.h>
+
+#if defined(__freeos__)
+
+#include <mono/utils/mono-threads.h>
+#include <pthread.h>
+
+void
+mono_threads_platform_get_stack_bounds (guint8 **staddr, size_t *stsize)
+{
+	pthread_attr_t attr;
+	gint res;
+
+	*staddr = NULL;
+	*stsize = (size_t)-1;
+
+	res = pthread_getattr_np (pthread_self (), &attr);
+	if (G_UNLIKELY (res != 0))
+		g_error ("%s: pthread_getattr_np failed with \"%s\" (%d)", __func__, g_strerror (res), res);
+
+	res = pthread_attr_getstack (&attr, (void**)staddr, stsize);
+	if (G_UNLIKELY (res != 0))
+		g_error ("%s: pthread_attr_getstack failed with \"%s\" (%d)", __func__, g_strerror (res), res);
+
+	pthread_attr_destroy (&attr);
+}
+
+guint64
+mono_native_thread_os_id_get (void)
+{
+	return (guint64)pthread_getthreadid_np ();
+}
+
+#else
+
+#include <mono/utils/mono-compiler.h>
+
+MONO_EMPTY_SOURCE_FILE (mono_threads_freeos);
+
+#endif
