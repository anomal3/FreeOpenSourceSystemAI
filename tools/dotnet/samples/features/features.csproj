<Project Sdk="Microsoft.NET.Sdk">

  <!-- Образец для фазы N1: в одной небольшой сборке всё, что компилятор C#
       пишет в метаданные, — чтобы сверка с чужим читателем задела каждую
       таблицу, а не только те, что есть у Hello World. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
