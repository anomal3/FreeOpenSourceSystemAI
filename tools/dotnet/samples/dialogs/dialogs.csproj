<Project Sdk="Microsoft.NET.Sdk">

  <!-- Образец для фазы N7c: таймер и окно сообщения из дизайнера. clr-check
       запускает его с аргументом self-test: таймер отсчитывает три тика, и форма
       закрывается. MessageBox в самопроверку не входит: модальное окно Windows
       ждало бы человека. На стенде кнопка открывает его, и мышь отвечает. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
