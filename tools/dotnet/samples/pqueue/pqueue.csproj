<Project Sdk="Microsoft.NET.Sdk">

  <!-- Образец для фазы N10: PriorityQueue, внесённая в corelib из dotnet/runtime
       без правки. Кроме порядка извлечения печатается и раскладка кучи
       (UnorderedItems) — она совпадает с dotnet только при том же алгоритме. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
