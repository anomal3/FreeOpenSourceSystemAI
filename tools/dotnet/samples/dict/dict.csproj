<Project Sdk="Microsoft.NET.Sdk">

  <!-- Образец для фазы N10d: Dictionary<TKey, TValue> и HashSet<T> из
       dotnet/runtime. Печатает то, что решает не договор, а алгоритм: порядок
       обхода после удалений и повторных вставок, простые размеры таблиц,
       порядок множества после операций над ним, поиск по срезу знаков. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
