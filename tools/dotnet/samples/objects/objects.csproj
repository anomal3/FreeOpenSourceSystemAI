<Project Sdk="Microsoft.NET.Sdk">

  <!-- Образец для фазы N3a: классы и поля, конструкторы, виртуальные вызовы,
       интерфейсы (явная реализация и член по умолчанию), статические
       конструкторы, структуры с копированием по значению, упаковка, приведения
       типов и массивы. Вывод сверяется с настоящим dotnet побайтно. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
