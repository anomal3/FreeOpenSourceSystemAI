<Project Sdk="Microsoft.NET.Sdk">

  <!-- Образец для фазы N7b: список и выпадающий список из дизайнера. clr-check
       запускает его с аргументом self-test: форма меняет элементы из кода и
       закрывается. На стенде строки выбирают мышь и клавиатура. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
