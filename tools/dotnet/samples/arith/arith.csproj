<Project Sdk="Microsoft.NET.Sdk">

  <!-- Образец для фазы N2: всё, что интерпретатор обязан уметь до объектов, —
       арифметика трёх ширин, ветвления, циклы, рекурсия, статические вызовы,
       switch и склейка строк. Вывод сверяется с настоящим dotnet побайтно. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
