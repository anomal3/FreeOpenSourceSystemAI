<Project Sdk="Microsoft.NET.Sdk">

  <!-- Образец для фазы N3b: throw, catch по типу, фильтры when, finally,
       using, rethrow, исключения среды и исключение из finally. Вывод
       сверяется с настоящим dotnet побайтно. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
