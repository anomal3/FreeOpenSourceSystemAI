<Project Sdk="Microsoft.NET.Sdk">

  <!-- Образец для фазы N4c: дробные числа — печать, форматы, разбор, Math,
       float. Вывод сверяется с настоящим dotnet в режиме инвариантной
       глобализации — у FreeOS культур нет. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
