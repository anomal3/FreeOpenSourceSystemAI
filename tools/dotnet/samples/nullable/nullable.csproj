<Project Sdk="Microsoft.NET.Sdk">

  <!-- Образец для фазы N10b: Nullable<T> — упаковка в null или в сам T,
       распаковка обратно, `is int?`, операторы и `?.` со значимым результатом.
       Всё это у .NET делает среда, и печатается то, что программа видит. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
