<Project Sdk="Microsoft.NET.Sdk">

  <!-- Образец для фазы N3c: обобщённые типы и методы, специализированные
       значимыми типами, статические поля у каждого экземпляра, constrained.
       на параметре типа, делегаты, замыкания, события и интерполяция строк.
       Вывод сверяется с настоящим dotnet побайтно. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
